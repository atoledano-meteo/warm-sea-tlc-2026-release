&share
    wrf_core = 'ARW'
    max_dom = 2
    start_date = '2026-10-02_12:00:00', '2026-10-02_12:00:00'
    end_date = '2026-10-05_00:00:00', '2026-10-05_00:00:00'
    interval_seconds = 10800
    io_form_geogrid = 2
/

&geogrid
    parent_id = 1, 1
    parent_grid_ratio = 1, 3
    i_parent_start = 1, 114
    j_parent_start = 1, 71
    e_we = 301, 361
    e_sn = 241, 331
    geog_data_res = 'default', 'default'
    dx = 9000
    dy = 9000
    map_proj = 'lambert'
    ref_lat = 40.0
    ref_lon = 0.0
    truelat1 = 40.0
    truelat2 = 40.0
    stand_lon = 0.0
    geog_data_path = 'WPS_GEOG'
/

&ungrib
    out_format = 'WPS'
    prefix = 'IFS'
/

&metgrid
    fg_name = 'IFS'
    io_form_metgrid = 2
/
